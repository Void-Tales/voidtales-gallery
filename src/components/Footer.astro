---
import BrandMark from './BrandMark.astro';
import { siteConfig } from '../config/site.js';
import { footerColumns, isExternal, joinUrl } from '../config/navigation.js';

const year = new Date().getFullYear();
// Same markup as the portal footer (voidtales-portal src/components/Footer.astro).
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <a href={siteConfig.network.url} class="brand">
          <BrandMark />
          {siteConfig.network.name}
        </a>
        <p>{siteConfig.network.tagline}</p>
        <a href={joinUrl} class="footer-address"><code>{siteConfig.network.server}</code></a>
      </div>

      {footerColumns.map(col => (
        <nav class="footer-col" aria-label={col.title}>
          <p class="footer-col-title">{col.title}</p>
          <ul>
            {col.links.map(link => (
              <li>
                <a
                  href={link.href}
                  target={isExternal(link.href) ? '_blank' : undefined}
                  rel={isExternal(link.href) ? 'noopener' : undefined}
                >{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <p class="footer-copyright">© {year} {siteConfig.footer.copyright} <button type="button" class="zaehlen-aendern" data-zaehlen-aendern hidden>Visit counting</button></p>
  </div>
</footer>
{/* Consent for visit counting (Umami, § 25 TDDDG): public/zaehlen.js loads the tracker only after "Yes".
    Same id on every voidtales.win host; Umami records the hostname, so portal, gallery and wiki stay apart.
    The choice lives in localStorage per host, so the gallery asks once on its own. */}
<section class="zaehlen" data-zaehlen data-id="7c235267-8275-439c-8449-39b753460c67" hidden aria-labelledby="zaehlen-titel">
  <p class="zaehlen-titel" id="zaehlen-titel">Mind if we count your visit?</p>
  <p>Only which pages get read. No cookies, our own server, no ads. <a href="https://portal.voidtales.win/privacy/#analytics">Details</a></p>
  <div class="zaehlen-wahl"><button type="button" data-wahl="ja">Yes</button><button type="button" data-wahl="nein">No</button></div>
</section>
<script is:inline defer src="/zaehlen.js?v=1"></script>
