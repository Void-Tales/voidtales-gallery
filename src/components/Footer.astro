---
import BrandMark from './BrandMark.astro';
import { siteConfig } from '../config/site.js';
import { footerColumns, isExternal, joinUrl } from '../config/navigation.js';

const year = new Date().getFullYear();
// Same markup as the portal footer (voidtales-portal src/components/Footer.astro).
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <a href={siteConfig.network.url} class="brand">
          <BrandMark />
          {siteConfig.network.name}
        </a>
        <p>{siteConfig.network.tagline}</p>
        <a href={joinUrl} class="footer-address">{siteConfig.network.server}</a>
      </div>

      {footerColumns.map(col => (
        <nav class="footer-col" aria-label={col.title}>
          <p class="footer-col-title">{col.title}</p>
          <ul>
            {col.links.map(link => (
              <li>
                <a
                  href={link.href}
                  target={isExternal(link.href) ? '_blank' : undefined}
                  rel={isExternal(link.href) ? 'noopener' : undefined}
                >{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <p class="footer-copyright">© {year} {siteConfig.footer.copyright}</p>
  </div>
</footer>
